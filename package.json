{
  "name": "blindboxai",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "affiliate:report": "node --env-file=.env.local scripts/affiliate-click-report.mjs",
    "labubu:generate": "node scripts/labubu-post-generator.mjs",
    "labubu:validate": "node scripts/labubu-validate.mjs",
    "labubu:test": "node --test scripts/labubu-test.mjs",
    "video:daily": "node scripts/video-pipeline.mjs daily",
    "video:notebooklm": "node --env-file-if-exists=.env.local scripts/notebooklm-video-ingest.mjs",
    "video:notebooklm-ready": "bash scripts/notebooklm-epn-ready.sh",
    "video:mobile-flow": "bash scripts/mobile-video-flow.sh",
    "video:link-only": "node --env-file-if-exists=.env.local scripts/link-only-video-flow.mjs",
    "video:direct-epn-publish": "node --env-file-if-exists=.env.local scripts/publish-direct-epn-video.mjs",
    "video:approve": "node scripts/video-pipeline.mjs approve",
    "video:reject": "node scripts/video-pipeline.mjs reject",
    "video:publish": "node --env-file-if-exists=.env.local scripts/video-pipeline.mjs publish",
    "video:zapier": "node scripts/zapier-video-payload.mjs",
    "video:test": "node --test scripts/video-pipeline.test.mjs scripts/notebooklm-video-ingest.test.mjs scripts/gemini-tts-disclosure.test.mjs",
    "daily:stage": "node scripts/daily-product-pipeline.mjs stage",
    "daily:mark-staged": "node scripts/daily-product-pipeline.mjs mark-staged",
    "daily:mark-failed": "node scripts/daily-product-pipeline.mjs mark-failed",
    "daily:preflight": "node scripts/daily-product-pipeline.mjs preflight",
    "daily:publish": "node scripts/daily-product-pipeline.mjs publish",
    "daily:validate": "node scripts/daily-product-pipeline.mjs validate",
    "daily:test": "node --test scripts/daily-product-pipeline.test.mjs scripts/daily-product-publish-safety.test.mjs scripts/social-card.test.mjs",
    "test": "npm run labubu:test && npm run video:test && npm run daily:test",
    "validate": "npm run labubu:validate -- --skip-url-check && node scripts/video-pipeline.mjs validate && npm run daily:validate"
  },
  "dependencies": {
    "@vercel/blob": "2.6.1",
    "next": "16.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "0.35.3"
  }
}
