  "priority": "Rank opportunities by verified buyer intent, transaction value, monetization fit, evidence strength, liquidity, sell-through, and content opportunity.",
  "evidenceRules": {
    "marketValue": "Prefer completed/sold transactions over asking prices.",
    "minimumIndependentSales": 2,
    "affiliateEconomics": [
      "program status",
      "commission",
      "attribution or cookie window",
      "geographic eligibility",
      "qualifying action",
      "direct-link capability"
    ],
    "buyerRisk": [
      "counterfeit evidence",
      "reseal/tampering evidence",
      "authentication procedure",
      "grading or certification verification",
      "documented buyer complaints"
    ],
    "demand": [
      "search intent",
      "YouTube/topic demand",
      "marketplace activity",
      "pre-purchase research behavior",
      "competition/saturation"
    ],
    "sportsAndCollectorSignals": [
      "rookie-card demand",
      "autograph and memorabilia-card demand",
      "serial-numbered and parallel scarcity",
      "population-report and grade scarcity",
      "set and case-break economics",
      "seasonal and player/event catalysts",
      "liquidity and sell-through"
    ]
  },
  "ranking": {
    "formula": "qualified buyer intent x transaction value x conversion opportunity x monetization fit x evidence confidence x liquidity x sell-through",
    "reject": [
      "unsupported asking-price claims",
      "guaranteed-profit claims",
      "unverified affiliate economics",
      "single-source market conclusions"
    ]
  },
  "security": {
    "publicResearchOnly": true,
    "credentialsAllowed": false,
    "secretsAllowed": false,
    "privateAccountAccess": false,
    "transactionsAllowed": false,
    "publishingAllowed": false,
