export function cleanText(value, maximum = 300) {
  return String(value ?? "")
    .replace(/\u0000/g, "")
    .replace(/\s+/g, " ")
    .trim()
    .slice(0, maximum);
}

export function cleanEmail(value) {
  const email = cleanText(value, 160).toLowerCase();

  if (!email) {
    return "";
  }

  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
    throw new Error("Invalid contributor email.");
  }

  return email;
}

export function cleanOptionalHttpUrl(value) {
  const raw = cleanText(value, 500);

  if (!raw) {
    return "";
  }

  let parsed;

  try {
    parsed = new URL(raw);
  } catch {
    throw new Error("Invalid permission or source URL.");
  }

  if (!["https:", "http:"\].includes\(parsed.protocol\)\) {
    throw new Error("Source URLs must use HTTPS or HTTP.");
  }

  return parsed.toString().slice(0, 500);
}

export function assertSubmissionId(value) {
  const id = cleanText(value, 80);

  if (!/^[a-zA-Z0-9-]{16,80}$/.test(id)) {
    throw new Error("Invalid submission identifier.");
  }

  return id;
}

export function assertUploadCode(value) {
  const expected = process.env.EVIDENCE_UPLOAD_CODE;
  const supplied = String(value ?? "");

  if (!expected) {
    throw new Error("Evidence uploads are not configured.");
  }

  const expectedBuffer = Buffer.from(expected);
  const suppliedBuffer = Buffer.from(supplied);

  if (
    expectedBuffer.length !== suppliedBuffer.length ||
    !timingSafeEqual(expectedBuffer, suppliedBuffer)
  ) {
    throw new Error("Invalid submission access code.");
  }
}

export function assertChoice(value, allowed, label) {
  const result = cleanText(value, 100);

  if (!allowed.has(result)) {
    throw new Error(`Invalid ${label}.`);
  }

  return result;
}

export function assertClassificationBasis(
  classification,
  authenticityBasis,
) {
  if (
    classification === "verified-genuine-reference" &&
    ![
      "official-verification-result",
      "authorized-retailer-purchase",
      "documented-provenance",
    ].includes(authenticityBasis)
  ) {
    throw new Error(
      "A verified-genuine reference requires official verification, " +
        "authorized-retailer provenance, or documented provenance.",
    );
  }
}
